# 依赖与构建产物
node_modules/
dist/
dist-verify/
dist-ssr/
*.local

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# 环境变量（只提交 .env.example 与 .env.production）
# ★ .env.production 必须入库：生产构建在部署机上执行，TURN 中继配置若不入库
#   会导致产物里没有 turn 地址，跨网段投屏静默失效（详见 .env.production 注释）。
.env
.env.*
!.env.example
!.env.production

# 证书私钥不入库（公钥 ca.crt / srv.crt 需随项目交付，供客户端与运维使用）
deploy/cert/*.key
deploy/cert/*.csr
deploy/cert/*.srl

# 系统
.DS_Store
Thumbs.db
