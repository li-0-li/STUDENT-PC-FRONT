# 生产构建配置（vite build 时加载；★ 必须入库，否则部署机构建出来会丢配置）
#
# ── 为什么必须有这个文件 ─────────────────────────────────────────────
# .gitignore 忽略了 .env.*，接口地址与 ws 地址此前只写在 .env.local（本机私有文件）。
# 后果：运维在服务器上 clone 后 npm run build，产物里没有这些地址，只能靠同域相对路径推导。
# 因此把「生产可确定、不含密钥」的配置显式入库；LiveKit / TURN 的密钥一律由后端
# 环境变量注入（LIVEKIT_* / TURN_*），前端不接触任何密钥。
#
# ── 接口地址：留空 = 相对路径 ────────────────────────────────────────
# 留空后 axios baseURL = ''，所有请求走同域相对路径 /api/v1/...
# 由 Nginx 反代到后端，前端不需要知道后端在哪台机器、哪个端口。
VITE_API_BASE_URL=

# ── WebSocket：留空 = 按当前页面自动推导 ─────────────────────────────
# useCastSignaling / useClassroomSocket 的 wsUrl() 逻辑：
#   VITE_WS_BASE_URL || `${location.protocol === 'https:' ? 'wss:' : 'ws:'}//${location.host}`
# 留空即同域：https 页面自动用 wss，http 页面自动用 ws，无需任何配置。
VITE_WS_BASE_URL=

# ── TURN 中继（2026-11-10 投屏下线后前端暂不使用）────────────────────
# 屏幕共享（WebRTC）已下线，课堂改为「课件/板书同步 + LiveKit 纯音频」，
# 前端不再需要 ICE/TURN 配置。后端 GET /api/v1/stu/live/turn-credentials 保留，
# 供后续教师端投屏立项时复用；本文件无需任何 TURN 变量。

# 应用标题
VITE_APP_TITLE=智能课平台 · 学生端

# 生产禁用 Mock（只有显式 =1 才启用，这里显式写 0 双重保险）
VITE_USE_MOCK=0
