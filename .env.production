# 生产构建配置（vite build 时加载；★ 必须入库，否则部署机构建出来会丢配置）
#
# ── 为什么必须有这个文件 ─────────────────────────────────────────────
# .gitignore 忽略了 .env.*，TURN 配置此前只写在 .env.local（本机私有文件）。
# 后果：运维在服务器上 clone 后 npm run build，产物里没有 TURN 地址，
#       buildIceServers() 会退化成只有公共 stun:stun.l.google.com:19302。
#       跨网段（教师在家/校园网）打洞失败时无中继可用 → 投屏黑屏，且不报错。
#
# ── 接口地址：留空 = 相对路径 ────────────────────────────────────────
# 留空后 axios baseURL = ''，所有请求走同域相对路径 /api/v1/...
# 由 Nginx 反代到后端，前端不需要知道后端在哪台机器、哪个端口。
VITE_API_BASE_URL=

# ── WebSocket：留空 = 按当前页面自动推导 ─────────────────────────────
# useCastSignaling / useClassroomSocket 的 wsUrl() 逻辑：
#   VITE_WS_BASE_URL || `${location.protocol === 'https:' ? 'wss:' : 'ws:'}//${location.host}`
# 留空即同域：https 页面自动用 wss，http 页面自动用 ws，无需任何配置。
VITE_WS_BASE_URL=

# ── TURN 中继（运维部署的 coturn，2026-10-29 实测 Allocate 200）────────
# ★ 教师端共享屏幕必须配置：跨网段 P2P 打洞成功率不是 100%。
# ★ 生产建议改为 coturn 动态凭据（use-auth-secret + REST API 临时账号），
#   静态账号一旦泄露可被任意人白嫖流量。当前为演示期静态账号。
VITE_TURN_URLS=turn:47.114.123.118:3478
VITE_TURN_USERNAME=zhike
VITE_TURN_CREDENTIAL=zhike2026

# 应用标题
VITE_APP_TITLE=智能课平台 · 学生端

# 生产禁用 Mock（只有显式 =1 才启用，这里显式写 0 双重保险）
VITE_USE_MOCK=0
