{
  "name": "itap-web",
  "version": "0.1.0",
  "private": true,
  "description": "智能教学辅助平台（智课平台）前端 —— PC 三端 + 微信小程序端",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:public": "vite --mode public",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "serve:https": "node deploy/same-origin-gateway.mjs --dist ./dist --backend 127.0.0.1:8080 --port 8443",
    "e2e:cast": "node deploy/e2e-cast.mjs",
    "test:mock": "node scripts/mock-smoke.mjs",
    "lint": "eslint . --ext .js,.vue --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.vue --fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "katex": "^0.19.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.3",
    "pinia": "^2.2.4",
    "vue": "^3.4.38",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.28.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.8"
  }
}
