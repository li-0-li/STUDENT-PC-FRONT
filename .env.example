# 复制本文件为 .env.development / .env.production 后填写（.env* 不入库，只有本模板入库）
# 用法：import.meta.env.VITE_API_BASE_URL

# 接口基地址。开发环境留空表示走 vite 代理（见 vite.config.js）
VITE_API_BASE_URL=

# 应用标题
VITE_APP_TITLE=智能教学辅助平台

# 是否启用接口 Mock（1=启用本地 mock，0=走后端）
VITE_USE_MOCK=0

# 投屏 WebRTC 的 TURN 中转服务器（跨网段 / 跨 NAT 时必填，同网段可不填）
# 运维部署 coturn 后填写即可生效，无需改代码；多个地址用英文逗号分隔
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
