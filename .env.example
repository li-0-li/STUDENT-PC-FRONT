# 复制本文件为 .env.development / .env.production 后填写（.env* 不入库，只有本模板入库）
# 用法：import.meta.env.VITE_API_BASE_URL

# 接口基地址。开发环境留空表示走 vite 代理（见 vite.config.js）
VITE_API_BASE_URL=

# 应用标题
VITE_APP_TITLE=智能教学辅助平台

# 是否启用接口 Mock（1=启用本地 mock，0=走后端）
VITE_USE_MOCK=0

# TURN 中继（2026-11-10 投屏下线后前端暂不使用）
# 屏幕共享已下线，课堂改为「课件/板书同步 + LiveKit 纯音频」，班级内无需 ICE/TURN 配置。
# 后端 GET /api/v1/stu/live/turn-credentials 保留，供后续教师端投屏立项复用。
# 如未来恢复投屏，再按后端接口地址填写：
# VITE_TURN_CREDENTIALS_URL=
